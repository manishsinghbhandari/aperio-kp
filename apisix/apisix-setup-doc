5. Create haproxy configmap
=======================
cat > haproxy.cfg
global
    log stdout format raw local0
    maxconn 2000

defaults
    log global
    mode http
    option httplog
    timeout connect 5s
    timeout client  30s
    timeout server  30s

frontend http_front
    bind *:8080
    default_backend nginx_apps

backend nginx_apps
    balance roundrobin
    option httpchk GET /
    server app1 app1.apisix.svc.cluster.local:80 check
    server app2 app2.apisix.svc.cluster.local:80 check


kubectl create configmap haproxy-config --namespace apisix --from-file=haproxy.cfg
